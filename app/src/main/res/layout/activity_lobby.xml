<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LobbyActivity">

    <EditText
        android:id="@+id/editTextRoomName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="32dp"
        android:hint="Nombre de la sala"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonCreateRoom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Crear Sala"
        app:layout_constraintEnd_toEndOf="@+id/editTextRoomName"
        app:layout_constraintStart_toStartOf="@+id/editTextRoomName"
        app:layout_constraintTop_toBottomOf="@+id/editTextRoomName" />

    <Button
        android:id="@+id/buttonJoinRoom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Unirse a Sala"
        app:layout_constraintEnd_toEndOf="@+id/buttonCreateRoom"
        app:layout_constraintStart_toStartOf="@+id/buttonCreateRoom"
        app:layout_constraintTop_toBottomOf="@+id/buttonCreateRoom" />

</androidx.constraintlayout.widget.ConstraintLayout>
